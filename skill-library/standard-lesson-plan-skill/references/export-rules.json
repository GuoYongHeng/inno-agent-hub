{
  "metadata": {
    "dataType": "curated",
    "description": "Word-ready Markdown 导出规则。定义各课型教案的章节顺序、章节说明、表格列名与模板文件。导出章节顺序是强约束：教师拿到教案后的阅读顺序应当是备课顺序。"
  },
  "sharedRules": [
    "输出的 Markdown 必须能被直接粘贴进 Word 使用，不使用 HTML 标签或复杂嵌套",
    "一级标题只用于教案标题，二级标题对应各章节，不出现三级以下标题",
    "所有表格使用标准 Markdown 表格语法，单元格内不换行，多项内容用「；」分隔",
    "章节顺序按备课顺序固定，不因课型随意调整",
    "教师课后填写的部分（教学反思）保留空白填写区，不代写内容"
  ],
  "templates": {
    "new": {
      "label": "新授课教案",
      "sections": [
        "基本信息",
        "教材分析",
        "学情分析",
        "教学目标",
        "教学重点与难点",
        "教学准备",
        "教学过程",
        "板书设计",
        "作业设计",
        "评价量规",
        "教学反思"
      ],
      "sectionDescriptions": {
        "教材分析": "说明本课内容在教材中的位置、与前后知识的联系、课标对应要求",
        "学情分析": "说明学生已具备的基础、认知特点、可能出现的困难",
        "教学过程": "按环节给出时间、教师活动、学生活动与设计意图",
        "板书设计": "给出板书的整体布局与生成时机"
      },
      "activityFlowColumns": ["环节", "时间", "教师活动", "学生活动", "设计意图"],
      "rubricStructure": "single",
      "objectivesColumns": ["维度", "学习目标", "行为动词", "对应环节", "评价证据"],
      "extraTables": ["homeworkDesign"],
      "templateFile": "assets/template-new-lesson.md"
    },
    "review": {
